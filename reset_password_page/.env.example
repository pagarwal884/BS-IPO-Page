# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# SMTP Email Configuration
# For Gmail, use smtp.gmail.com
# For Outlook, use smtp-mail.outlook.com
# For Yahoo, use smtp.mail.yahoo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Database Configuration (if using database instead of in-memory storage)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bluestock
# DB_USER=your-db-user
# DB_PASS=your-db-password

# Security Configuration
# JWT_SECRET=your-jwt-secret-key
# BCRYPT_ROUNDS=12

# Application Configuration
# APP_NAME=Bluestock
# SUPPORT_EMAIL=support@bluestock.com